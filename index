<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EMPORIO LEGIS MEDICAL S.A.S.</title>
    <style>
        :root {
            --primary: #00204A;       /* Azul Marino Profundo */
            --secondary: #00A8CC;     /* Azul Turquesa Forense */
            --accent: #00D2D3;        /* Brillo Turquesa */
            --bg-light: #F4F7FA;      /* Fondo Claro */
            --text-dark: #1E293B;     /* Texto principal */
            --text-muted: #64748B;    /* Texto secundario */
            --white: #FFFFFF;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-light);
            color: var(--text-dark);
            overflow-x: hidden;
        }

        /* --- TOPBAR --- */
        .topbar {
            background: var(--primary);
            color: var(--white);
            padding: 8px 8%;
            font-size: 0.85rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        /* --- HEADER & NAVEGACIÓN --- */
        header {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        }

        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 8%;
            max-width: 1400px;
            margin: 0 auto;
        }

        .logo-box {
            display: flex;
            align-items: center;
            text-decoration: none;
        }

        .logo-box img {
            height: 55px;
            width: auto;
            object-fit: contain;
            transition: transform 0.3s ease;
        }

        .logo-box:hover img {
            transform: scale(1.03);
        }

        .nav-menu {
            display: flex;
            list-style: none;
            gap: 30px;
            position: relative;
        }

        .nav-link {
            text-decoration: none;
            color: var(--primary);
            font-weight: 600;
            font-size: 0.95rem;
            padding: 8px 4px;
            position: relative;
            transition: color 0.3s ease;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0%;
            height: 3px;
            background: linear-gradient(90deg, var(--secondary), var(--accent));
            border-radius: 2px;
            transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .nav-link:hover {
            color: var(--secondary);
        }

        .nav-link:hover::after {
            width: 100%;
        }

        .btn-header {
            background: linear-gradient(135deg, var(--primary), #003882);
            color: var(--white);
            padding: 10px 22px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            box-shadow: 0 4px 12px rgba(0, 32, 74, 0.2);
            transition: all 0.3s ease;
        }

        .btn-header:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(0, 168, 204, 0.4);
            background: linear-gradient(135deg, var(--secondary), var(--primary));
        }

        /* --- SECCIÓN HERO / BANNER --- */
        .hero {
            position: relative;
            min-height: 85vh;
            background: linear-gradient(135deg, #001530 0%, #00204A 60%, #004b7a 100%);
            color: var(--white);
            display: flex;
            align-items: center;
            padding: 60px 8%;
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(0,168,204,0.15) 0%, rgba(0,0,0,0) 70%);
            top: -150px;
            right: -100px;
            border-radius: 50%;
        }

        .hero-wrapper {
            max-width: 1300px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 50px;
            align-items: center;
            width: 100%;
            z-index: 2;
        }

        .hero-text h1 {
            font-size: 3rem;
            line-height: 1.15;
            margin-bottom: 20px;
            font-weight: 800;
        }

        .hero-text h1 span {
            color: var(--secondary);
            background: linear-gradient(90deg, var(--secondary), var(--accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-text p {
            font-size: 1.15rem;
            color: #CBD5E1;
            margin-bottom: 35px;
            line-height: 1.6;
        }

        .hero-buttons {
            display: flex;
            gap: 15px;
        }

        .btn-primary {
            background: linear-gradient(90deg, var(--secondary), #008cae);
            color: var(--white);
            padding: 14px 32px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 700;
            transition: all 0.3s ease;
            box-shadow: 0 10px 20px rgba(0, 168, 204, 0.3);
        }

        .btn-primary:hover {
            transform: translateX(5px);
            box-shadow: 0 12px 25px rgba(0, 168, 204, 0.5);
        }

        .btn-outline {
            border: 2px solid rgba(255,255,255,0.3);
            color: var(--white);
            padding: 14px 32px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-outline:hover {
            border-color: var(--secondary);
            color: var(--secondary);
            background: rgba(255, 255, 255, 0.05);
        }

        /* Tarjeta del Logo en el Banner */
        .hero-illustration {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .hero-logo-card {
            background: transparent;
            padding: 0;
            box-shadow: none;
            border: none;
            animation: float 6s ease-in-out infinite;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .hero-logo-card img {
            width: 100%;
            max-width: 420px;
            height: auto;
            object-fit: contain;
            mix-blend-mode: multiply; 
            filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.4));
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-12px); }
        }

        /* --- SECCIÓN SLIDER INTERACTIVO DE SERVICIOS --- */
        .section-padding {
            padding: 90px 8%;
            max-width: 1300px;
            margin: 0 auto;
        }

        .section-header {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-header h2 {
            font-size: 2.2rem;
            color: var(--primary);
            margin-bottom: 10px;
        }

        .section-header p {
            color: var(--text-muted);
        }

        .tabs-nav {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-bottom: 40px;
            flex-wrap: wrap;
        }

        .tab-btn {
            background: var(--white);
            border: 2px solid #E2E8F0;
            padding: 12px 25px;
            border-radius: 30px;
            font-weight: 600;
            color: var(--primary);
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .tab-btn.active, .tab-btn:hover {
            background: var(--primary);
            color: var(--white);
            border-color: var(--primary);
            box-shadow: 0 8px 15px rgba(0,32,74,0.15);
        }

        .tab-content-wrapper {
            position: relative;
            min-height: 250px;
        }

        .tab-pane {
            display: none;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            opacity: 0;
            transform: translateX(30px);
            transition: all 0.4s ease-in-out;
        }

        .tab-pane.active {
            display: grid;
            opacity: 1;
            transform: translateX(0);
        }

        .card-service {
            background: var(--white);
            padding: 35px 25px;
            border-radius: 12px;
            border-top: 4px solid var(--secondary);
            box-shadow: 0 10px 30px rgba(0,0,0,0.04);
            transition: all 0.3s ease;
        }

        .card-service:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(0,32,74,0.1);
        }

        .card-service h3 {
            color: var(--primary);
            font-size: 1.3rem;
            margin-bottom: 15px;
        }

        .card-service p {
            color: var(--text-muted);
            font-size: 0.95rem;
            line-height: 1.6;
        }

        /* --- SECCIÓN VENTAJAS --- */
        .features {
            background: var(--white);
            border-y: 1px solid #E2E8F0;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 30px;
            text-align: center;
        }

        .feature-item h3 {
            font-size: 2.5rem;
            color: var(--secondary);
            font-weight: 800;
            margin-bottom: 5px;
        }

        .feature-item p {
            color: var(--primary);
            font-weight: 600;
        }

        /* FOOTER */
        footer {
            background: var(--primary);
            color: var(--white);
            padding: 60px 8% 20px;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-bottom {
            text-align: center;
            padding-top: 25px;
            border-top: 1px solid rgba(255,255,255,0.1);
            color: #94A3B8;
            font-size: 0.85rem;
        }

        @media (max-width: 900px) {
            .hero-wrapper {
                grid-template-columns: 1fr;
                text-align: center;
            }
            .hero-buttons {
                justify-content: center;
            }
            .nav-menu {
                display: none;
            }
        }
    </style>
</head>
